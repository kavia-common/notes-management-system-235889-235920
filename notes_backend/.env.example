# Backend runtime
PORT=3001
HOST=0.0.0.0

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_MAX_AGE=3600

# Auth (set in production)
JWT_SECRET=change-me
JWT_ISSUER=notes-backend
# Optional audience validation
# JWT_AUDIENCE=notes-frontend
ACCESS_TOKEN_TTL_MINUTES=120

# Optional override if db_connection.txt lives elsewhere
# DB_CONNECTION_FILE=/absolute/path/to/db_connection.txt
